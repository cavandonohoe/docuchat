# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=docuchat
POSTGRES_PASSWORD=docuchat
POSTGRES_DB=docuchat
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://docuchat:docuchat@db:5432/docuchat

# LLM provider
# Default: OpenAI hosted API. Leave OPENAI_BASE_URL empty for that.
# For a free local stack via Ollama (https://ollama.com), set:
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768
#   CHAT_MODEL=llama3.2:3b
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Storage
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
